<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STADIUM Staking Terminal | Live Leaderboard</title>
    <meta name="description" content="Real-time SYND staking leaderboard for Stadium appchain">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --stadium-green: #00ff41;
            --stadium-dark: #0a0e12;
            --stadium-gray: #1a1f26;
            --stadium-border: #2a3744;
            --stadium-text: #e0e0e0;
            --stadium-accent: #00cc33;
        }

        body {
            font-family: 'Courier New', monospace;
            background-color: var(--stadium-dark);
            color: var(--stadium-text);
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .scanlines {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(
                0deg,
                rgba(0, 0, 0, 0.15),
                rgba(0, 0, 0, 0.15) 1px,
                transparent 1px,
                transparent 2px
            );
            pointer-events: none;
            z-index: 1000;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
            position: relative;
            z-index: 1;
        }

        .terminal-window {
            background: var(--stadium-gray);
            border: 2px solid var(--stadium-green);
            border-radius: 8px;
            box-shadow: 0 0 30px rgba(0, 255, 65, 0.3);
            overflow: hidden;
        }

        .terminal-header {
            background: var(--stadium-dark);
            padding: 15px 20px;
            border-bottom: 2px solid var(--stadium-green);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .terminal-title {
            color: var(--stadium-green);
            font-size: 1.2em;
            font-weight: bold;
            text-shadow: 0 0 10px var(--stadium-green);
        }

        .terminal-status {
            display: flex;
            gap: 15px;
            align-items: center;
            font-size: 0.9em;
        }

        .status-indicator {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--stadium-green);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .terminal-body {
            padding: 30px;
        }

        .ascii-logo {
            color: var(--stadium-green);
            font-size: 0.65em;
            line-height: 1.2;
            text-align: center;
            margin-bottom: 30px;
            text-shadow: 0 0 10px var(--stadium-green);
            white-space: pre;
            overflow-x: auto;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: var(--stadium-dark);
            border: 1px solid var(--stadium-border);
            border-left: 4px solid var(--stadium-green);
            padding: 20px;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            border-left-color: var(--stadium-accent);
            box-shadow: 0 0 20px rgba(0, 255, 65, 0.2);
        }

        .stat-label {
            font-size: 0.9em;
            color: #888;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-value {
            font-size: 2em;
            color: var(--stadium-green);
            font-weight: bold;
            text-shadow: 0 0 10px var(--stadium-green);
        }

        .stat-subtitle {
            font-size: 0.85em;
            color: #666;
            margin-top: 5px;
        }

        .section {
            background: var(--stadium-dark);
            border: 1px solid var(--stadium-border);
            border-radius: 4px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .section-title {
            color: var(--stadium-green);
            font-size: 1.3em;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--stadium-border);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .terminal-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.95em;
        }

        .terminal-table thead {
            background: var(--stadium-gray);
        }

        .terminal-table th {
            padding: 12px;
            text-align: left;
            color: var(--stadium-green);
            border-bottom: 2px solid var(--stadium-green);
            text-transform: uppercase;
            font-size: 0.9em;
            letter-spacing: 1px;
        }

        .terminal-table td {
            padding: 12px;
            border-bottom: 1px solid var(--stadium-border);
        }

        .terminal-table tbody tr:hover {
            background: rgba(0, 255, 65, 0.05);
        }

        .rank-badge {
            display: inline-block;
            width: 30px;
            height: 30px;
            line-height: 30px;
            text-align: center;
            border-radius: 50%;
            font-weight: bold;
        }

        .rank-1 { background: #FFD700; color: #000; }
        .rank-2 { background: #C0C0C0; color: #000; }
        .rank-3 { background: #CD7F32; color: #000; }
        .rank-other { background: var(--stadium-border); color: var(--stadium-text); }

        .wallet-address {
            font-family: 'Courier New', monospace;
            color: var(--stadium-accent);
        }

        .refresh-btn {
            background: var(--stadium-dark);
            color: var(--stadium-green);
            border: 2px solid var(--stadium-green);
            padding: 12px 30px;
            font-family: 'Courier New', monospace;
            font-size: 1em;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .refresh-btn:hover {
            background: var(--stadium-green);
            color: var(--stadium-dark);
            box-shadow: 0 0 20px var(--stadium-green);
        }

        .refresh-btn:active {
            transform: scale(0.95);
        }

        .terminal-footer {
            background: var(--stadium-dark);
            padding: 20px;
            border-top: 2px solid var(--stadium-green);
            text-align: center;
            font-size: 0.85em;
            color: #666;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: var(--stadium-green);
            font-size: 1.2em;
        }

        .loading::after {
            content: '...';
            animation: dots 1.5s steps(4, end) infinite;
        }

        @keyframes dots {
            0%, 20% { content: '.'; }
            40% { content: '..'; }
            60%, 100% { content: '...'; }
        }

        .error {
            background: rgba(255, 0, 0, 0.1);
            border: 1px solid #ff0000;
            color: #ff6b6b;
            padding: 15px;
            border-radius: 4px;
            margin: 20px 0;
        }

        @media (max-width: 768px) {
            .terminal-body {
                padding: 15px;
            }

            .ascii-logo {
                font-size: 0.4em;
            }

            .stat-value {
                font-size: 1.5em;
            }

            .terminal-table {
                font-size: 0.85em;
            }

            .terminal-table th,
            .terminal-table td {
                padding: 8px 6px;
            }
        }

        .percentage-bar {
            width: 100%;
            height: 8px;
            background: var(--stadium-border);
            border-radius: 4px;
            overflow: hidden;
            margin-top: 8px;
        }

        .percentage-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--stadium-accent), var(--stadium-green));
            transition: width 0.5s ease;
        }
    </style>
</head>
<body>
    <div class="scanlines"></div>
    
    <div class="container">
        <div class="terminal-window">
            <!-- Header -->
            <div class="terminal-header">
                <div class="terminal-title">⚡ STADIUM STAKING TERMINAL</div>
                <div class="terminal-status">
                    <div class="status-indicator">
                        <span class="status-dot"></span>
                        <span>LIVE</span>
                    </div>
                    <div id="lastUpdated">Loading...</div>
                </div>
            </div>

            <!-- Body -->
            <div class="terminal-body">
                <!-- ASCII Logo -->
                <div class="ascii-logo">
███████╗████████╗ █████╗ ████████╗██╗██╗   ██╗███╗   ███╗
██╔════╝╚══██╔══╝██╔══██╗╚══██╔══╝██║██║   ██║████╗ ████║
███████╗   ██║   ███████║   ██║   ██║██║   ██║██╔████╔██║
╚════██║   ██║   ██╔══██║   ██║   ██║██║   ██║██║╚██╔╝██║
███████║   ██║   ██║  ██║   ██║   ██║╚██████╔╝██║ ╚═╝ ██║
╚══════╝   ╚═╝   ╚═╝  ╚═╝   ╚═╝   ╚═╝ ╚═════╝ ╚═╝     ╚═╝
                PLAY WITH PURPOSE - COMPETE & EARN
                </div>

                <!-- Loading State -->
                <div id="loadingState" class="loading">
                    Fetching staking data from Syndicate Commons
                </div>

                <!-- Error State -->
                <div id="errorState" class="error" style="display: none;">
                    <strong>⚠️ Error:</strong> <span id="errorMessage"></span>
                </div>

                <!-- Main Content (Hidden until data loads) -->
                <div id="mainContent" style="display: none;">
                    <!-- Stadium Stats -->
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-label">🏟️ Total Staked</div>
                            <div class="stat-value" id="totalStaked">0</div>
                            <div class="stat-subtitle">SYND to Stadium</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">👥 Total Stakers</div>
                            <div class="stat-value" id="totalStakers">0</div>
                            <div class="stat-subtitle">Unique Wallets</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">🏆 Ecosystem Rank</div>
                            <div class="stat-value" id="ecosystemRank">#-</div>
                            <div class="stat-subtitle">Out of All Appchains</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">📊 Network Share</div>
                            <div class="stat-value" id="networkShare">0%</div>
                            <div class="stat-subtitle">Of Total SYND Staked</div>
                        </div>
                    </div>

                    <!-- Ecosystem Rankings -->
                    <div class="section">
                        <div class="section-title">🌐 ECOSYSTEM RANKINGS</div>
                        <div style="overflow-x: auto;">
                            <table class="terminal-table">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Appchain ID</th>
                                        <th>Total Staked</th>
                                        <th>Stakers</th>
                                        <th>Share</th>
                                    </tr>
                                </thead>
                                <tbody id="ecosystemTable">
                                    <!-- Populated by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Top 10 Stakers -->
                    <div class="section">
                        <div class="section-title">👑 TOP 10 STAKERS</div>
                        <div style="overflow-x: auto;">
                            <table class="terminal-table">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Wallet Address</th>
                                        <th>Amount Staked</th>
                                        <th>% of Stadium Total</th>
                                    </tr>
                                </thead>
                                <tbody id="top10Table">
                                    <!-- Populated by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Refresh Button -->
                    <div style="text-align: center; margin-top: 30px;">
                        <button class="refresh-btn" onclick="fetchData()">🔄 REFRESH DATA</button>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="terminal-footer">
                <div>Contract: 0xF9637B60f27AF139FC46EAa655cFBbe4E731BCdF | Appchain: 574014</div>
                <div style="margin-top: 10px;">
                    Data Source: <a href="https://commons.explorer.syndicate.io" target="_blank" style="color: var(--stadium-green);">Syndicate Commons Explorer</a>
                </div>
                <div style="margin-top: 10px; color: #444;">
                    © 2025 STADIUM LEAGUE CO. | Auto-refresh every 5 minutes
                </div>
            </div>
        </div>
    </div>

    <script>
        // Configuration
        const CONFIG = {
            STADIUM_APPCHAIN_ID: 574014,
            CONTRACT_ADDRESS: '0xF9637B60f27AF139FC46EAa655cFBbe4E731BCdF',
            REFRESH_INTERVAL: 5 * 60 * 1000, // 5 minutes
            API_ENDPOINT: '/api/stats' // Use relative path - works for both local and deployed
        };

        let refreshTimer;

        // Format number with commas
        function formatNumber(num) {
            return num.toLocaleString('en-US', { 
                minimumFractionDigits: 2, 
                maximumFractionDigits: 2 
            });
        }

        // Format wallet address (show first 6 and last 4)
        function formatAddress(address) {
            if (!address) return 'Unknown';
            return `${address.substring(0, 6)}...${address.substring(address.length - 4)}`;
        }

        // Update UI with data
        function updateUI(stats) {
            // Hide loading, show content
            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('errorState').style.display = 'none';
            document.getElementById('mainContent').style.display = 'block';

            // Update Stadium stats
            document.getElementById('totalStaked').textContent = formatNumber(stats.stadium.totalStaked);
            document.getElementById('totalStakers').textContent = stats.stadium.totalStakers;
            document.getElementById('ecosystemRank').textContent = `#${stats.stadium.rank}`;
            document.getElementById('networkShare').textContent = `${stats.stadium.networkShare.toFixed(2)}%`;

            // Update ecosystem table
            const ecosystemTable = document.getElementById('ecosystemTable');
            ecosystemTable.innerHTML = stats.ecosystem.slice(0, 10).map(item => {
                const isStadium = item.appchainId === CONFIG.STADIUM_APPCHAIN_ID;
                return `
                    <tr style="${isStadium ? 'background: rgba(0, 255, 65, 0.1); font-weight: bold;' : ''}">
                        <td>
                            <span class="rank-badge rank-${item.rank <= 3 ? item.rank : 'other'}">
                                ${item.rank}
                            </span>
                        </td>
                        <td>${item.appchainId}${isStadium ? ' 🏟️' : ''}</td>
                        <td>${formatNumber(item.total)} SYND</td>
                        <td>${item.stakers}</td>
                        <td>
                            ${item.share.toFixed(2)}%
                            <div class="percentage-bar">
                                <div class="percentage-fill" style="width: ${item.share}%"></div>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            // Update top 10 table
            const top10Table = document.getElementById('top10Table');
            top10Table.innerHTML = stats.top10.map(item => `
                <tr>
                    <td>
                        <span class="rank-badge rank-${item.rank <= 3 ? item.rank : 'other'}">
                            ${item.rank}
                        </span>
                    </td>
                    <td>
                        <span class="wallet-address">${formatAddress(item.address)}</span>
                        <br>
                        <small style="color: #666;">${item.address}</small>
                    </td>
                    <td>${formatNumber(item.amount)} SYND</td>
                    <td>
                        ${item.percentage.toFixed(2)}%
                        <div class="percentage-bar">
                            <div class="percentage-fill" style="width: ${Math.min(item.percentage, 100)}%"></div>
                        </div>
                    </td>
                </tr>
            `).join('');

            // Update last updated time
            const now = new Date();
            document.getElementById('lastUpdated').textContent = now.toLocaleString();
        }

        // Show error
        function showError(message) {
            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('mainContent').style.display = 'none';
            document.getElementById('errorState').style.display = 'block';
            document.getElementById('errorMessage').textContent = message;
        }

        // Main fetch function
        async function fetchData() {
            try {
                console.log('Fetching staking data from API...');
                
                const response = await fetch(CONFIG.API_ENDPOINT);
                if (!response.ok) {
                    throw new Error(`API returned ${response.status}: ${response.statusText}`);
                }
                
                const stats = await response.json();
                console.log('Stats received:', stats);
                
                updateUI(stats);

                // Setup auto-refresh
                clearTimeout(refreshTimer);
                refreshTimer = setTimeout(fetchData, CONFIG.REFRESH_INTERVAL);
            } catch (error) {
                console.error('Error fetching data:', error);
                showError(`Failed to load staking data: ${error.message}`);
                
                // Retry after 30 seconds on error
                clearTimeout(refreshTimer);
                refreshTimer = setTimeout(fetchData, 30000);
            }
        }

        // Initialize on page load
        window.addEventListener('DOMContentLoaded', () => {
            console.log('Stadium Staking Terminal initialized');
            fetchData();
        });

        // Cleanup on page unload
        window.addEventListener('beforeunload', () => {
            clearTimeout(refreshTimer);
        });
    </script>
</body>
</html>
